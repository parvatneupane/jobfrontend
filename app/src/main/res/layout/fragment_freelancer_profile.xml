<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- HEADER -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Profile"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"/>

        <!-- PROFILE CARD -->

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            app:cardCornerRadius="24dp"
            app:cardBackgroundColor="@color/surface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:id="@+id/txtAvatar"
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    android:gravity="center"
                    android:text="P"
                    android:textSize="34sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary"
                    android:background="@color/primary_light"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/txtUsername"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Loading..."
                        android:textColor="@color/text_primary"
                        android:textSize="24sp"
                        android:textStyle="bold"/>

                    <ImageView
                        android:id="@+id/imgVerifiedBadge"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="6dp"
                        android:src="@drawable/ic_verified"
                        android:visibility="gone"/>

                </LinearLayout>

                <TextView
                    android:id="@+id/txtTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Loading..."
                    android:textColor="@color/text_secondary"/>

                <TextView
                    android:id="@+id/txtCategories"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text=""
                    android:textSize="14sp"
                    android:textStyle="italic"
                    android:textColor="@color/primary"
                    android:visibility="gone"/>

                <TextView
                    android:id="@+id/txtAvailability"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Available"
                    android:textStyle="bold"
                    android:textColor="@color/success"/>

                <Button
                    android:id="@+id/btnEditProfile"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="22dp"
                    android:text="Edit Profile"
                    android:textAllCaps="false"
                    android:textColor="@color/text_on_primary"
                    android:backgroundTint="@color/primary"/>

            </LinearLayout>

        </androidx.cardview.widget.CardView>


        <!-- VERIFY CARD -->

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            app:cardCornerRadius="22dp"
            app:cardBackgroundColor="@color/primary_light">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Verify Account"
                    android:textStyle="bold"
                    android:textSize="22sp"
                    android:textColor="@color/text_primary"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Unlock more opportunities"
                    android:textColor="@color/text_secondary"
                    android:layout_marginTop="4dp"/>

                <TextView
                    android:id="@+id/txtVerificationStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Status • Not Verified"
                    android:textStyle="bold"
                    android:textColor="@color/accent"
                    android:layout_marginTop="18dp"/>

                <TextView
                    android:id="@+id/txtVerificationDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:visibility="gone"
                    android:layout_marginTop="2dp"/>

                <Button
                    android:id="@+id/btnVerify"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="16dp"
                    android:text="Verify Now"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:backgroundTint="@color/primary"/>

            </LinearLayout>

        </androidx.cardview.widget.CardView>


        <!-- EARNINGS -->

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            app:cardCornerRadius="22dp"
            app:cardBackgroundColor="@color/primary">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="20dp"
                android:orientation="vertical">

                <TextView
                    android:text="Total Earnings"
                    android:textColor="@color/white"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:id="@+id/txtEarnings"
                    android:text="Rs. 0"
                    android:textColor="@color/white"
                    android:textSize="34sp"
                    android:textStyle="bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

            </LinearLayout>

        </androidx.cardview.widget.CardView>


        <!-- OVERVIEW -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Overview"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginTop="30dp"/>

        <Button
            android:id="@+id/btnPortfolio"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="My Portfolio"
            android:textAllCaps="false"
            android:layout_marginTop="12dp"/>

        <Button
            android:id="@+id/btnActiveInProgressJobs"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="In Progress Jobs"
            android:textAllCaps="false"
            android:layout_marginTop="10dp"/>

        <Button
            android:id="@+id/btnActiveCompletedJobs"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Completed Jobs"
            android:textAllCaps="false"
            android:layout_marginTop="10dp"/>

        <Button
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:text="Logout"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:backgroundTint="@color/accent"/>

        <Space
            android:layout_width="match_parent"
            android:layout_height="120dp"/>

    </LinearLayout>

</ScrollView>